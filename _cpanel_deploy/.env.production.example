PORT=5000
NODE_ENV=production
APP_URL=https://terranexusproperties.com
FRONTEND_URL=https://terranexusproperties.com
API_BASE_PATH=/

# Hostinger MySQL (from hPanel → Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_NAME=REPLACE_DB_NAME

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

ADMIN_EMAIL=admin@terranexusproperties.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Site Administrator
ADMIN_PHONE=7350196969

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
